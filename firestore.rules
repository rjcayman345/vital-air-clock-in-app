rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'rohan.vitalair@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Clock entries. Techs can add entries and close their own open one; only the admin can edit or delete.
    match /punches/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasAll(['tech','cust','type','start'])
                    && request.resource.data.type in ['travel','work','break'];
      allow update: if isAdmin()
                    || (signedIn() && resource.data.end == null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end','auto']));
      allow delete: if isAdmin();
    }

    // Jobs techs add from the app; only the admin can rename or remove them.
    match /jobs/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
