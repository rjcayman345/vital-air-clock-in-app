rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in (anonymous sign-in counts) app installs can read/write the timesheet.
    match /punches/{id} { allow read, write: if request.auth != null; }
    match /jobs/{id}    { allow read, write: if request.auth != null; }
  }
}
